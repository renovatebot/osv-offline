{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>renovatebot/.github"],
  "prCreation": "immediate",
  "automergeType": "pr",
  "packageRules": [
    {
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep the range so consumers can share one copy with the version pinned by @renovatebot/base-image",
      "matchPackageNames": ["@containerbase/base"],
      "rangeStrategy": "update-lockfile"
    }
  ]
}
