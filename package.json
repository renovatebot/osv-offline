{
  "name": "@renovatebot/osv-offline-monorepo",
  "version": "0.0.0-semantic-release",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/renovatebot/osv-offline.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "fix": "run-s fix:*",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "prepare": "husky",
    "start": "node ./packages/osv-offline-updater/src/index.ts",
    "test": "run-s lint test:unit test:integration",
    "test:unit": "vitest run unit.spec.ts --coverage.reportsDirectory=coverage/unit --outputFile.junit=.coverage/unit.junit.xml",
    "test:integration": "vitest run int.spec.ts --maxWorkers=1 --coverage.reportsDirectory=coverage/integration --outputFile.junit=.coverage/integration.junit.xml"
  },
  "devDependencies": {
    "@containerbase/oxlint-plugin": "1.0.5",
    "@containerbase/semantic-release-pnpm": "1.4.3",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@vitest/coverage-v8": "4.1.12",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "8.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.28.8"
}
